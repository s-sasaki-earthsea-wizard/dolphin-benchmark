__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.env

# profiler output
*.svg
*.speedscope.json
*.qdrep
*.nsys-rep
*.sqlite

# asv
.asv/

# run scratch: the container's /work mount (../results). Holds logs, intermediate
# rasters, run-subset/ outputs, *.nsys-rep, gpu probes — all regenerable.
# `/results/*` (not `/results/`) so the asv-baseline exception below can work:
# git cannot re-include files whose parent directory is itself excluded.
/results/*
# ...except the curated ASV baseline (result JSONs + README are deliverables,
# and future re-runs should show up as reviewable diffs).
!/results/asv-baseline/
!/results/asv-baseline/**
# ...and the unwrap-step breakdown results (summary + per-call records;
# the extracted NISAR rasters next to them stay ignored via the *.tif rule).
!/results/unwrap-breakdown/
!/results/unwrap-breakdown/**

# ...but curated report artifacts under reports/ ARE tracked, including the flame
# graph SVG that the global "*.svg" rule above would otherwise drop.
!reports/*.svg

# data — never commit SAR data
*.SAFE/
*.h5
*.nc
*.tif
*.tiff
*.zip
